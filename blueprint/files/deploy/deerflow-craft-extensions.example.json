{
  "mcpServers": {
    "vectorcraft": {
      "enabled": true,
      "type": "stdio",
      "command": "/opt/craft/vectorcraft/vectorcraft-0.21.1-linux-x86_64/bin/vectorcraft-cli",
      "args": [
        "mcp", "--headless",
        "--automation-read-root", "/opt/pod-pipeline-staging/data",
        "--automation-read-root", "/opt/pod-pipeline-staging/build",
        "--automation-write-root", "/opt/pod-pipeline-staging/craft-agent"
      ],
      "tool_name_prefix": true,
      "session_init_timeout": 120,
      "tool_call_timeout": 600,
      "description": "VectorCraft 0.21.1 headless engine (staging)"
    },
    "photocraft": {
      "enabled": true,
      "type": "stdio",
      "command": "/opt/craft/photocraft/photocraft-0.20.2-linux-x86_64/bin/photocraft-cli",
      "args": [
        "mcp",
        "--automation-read-root", "/opt/pod-pipeline-staging/data",
        "--automation-write-root", "/opt/pod-pipeline-staging/craft-agent"
      ],
      "tool_name_prefix": true,
      "session_init_timeout": 120,
      "tool_call_timeout": 600,
      "description": "PhotoCraft 0.20.2 headless engine (staging)"
    }
  }
}
