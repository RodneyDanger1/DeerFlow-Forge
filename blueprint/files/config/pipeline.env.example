# systemd EnvironmentFile. Do not quote values. setup-pipeline.sh replaces the tokens.
POD_ROOT=/opt/pod-pipeline
PYTHONPATH=/opt/pod-pipeline
DATABASE_URL=postgresql://pod_app:__DB_PASS__@127.0.0.1:5432/pod
POD_DB_PASS=__DB_PASS__
POD_CREDENTIAL_KEY=__CRED_KEY__
FW_BASE_URL=https://api.fourthwall.com
FW_API_USER=
FW_API_SECRET=
POD_USE_DOCKER=0
POD_DOCKER_IMAGE=pod-craft-runner:latest
POD_DOCKER_MEMORY=2g
POD_DOCKER_CPUS=1.5
POD_DOCKER_CPU_SHARES=256
POD_NICE_LEVEL=10
POD_MAX_CONCURRENCY=2
POD_STEP_TIMEOUT_S=900
POD_FALLBACK_RASTER_DPI=600
POD_MCP_HOST=127.0.0.1
POD_MCP_PORT=8765
POD_LOG_LEVEL=INFO
